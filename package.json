{
  "name": "oracle",
  "version": "0.1.0",
  "private": true,
  "description": "A test-oracle runtime for backend systems",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oracle": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "ORACLE_FIXTURE=1 node --import tsx --test test/integration/*.test.ts",
    "oracle": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
